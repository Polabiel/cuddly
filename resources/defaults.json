{
  "profiles": {
    "defaults": {
      "name": "Default",
      "commandline": "/bin/bash",
      "colorScheme": "Campbell",
      "fontSize": 12,
      "fontFamily": "monospace",
      "cursorShape": "bar",
      "cursorColor": "#FFFFFF",
      "scrollbackLines": 10000,
      "closeOnExit": "graceful"
    },
    "list": [
      {
        "name": "Bash",
        "commandline": "/bin/bash",
        "colorScheme": "Campbell",
        "fontSize": 12,
        "fontFamily": "monospace"
      },
      {
        "name": "Zsh",
        "commandline": "/bin/zsh",
        "colorScheme": "One Half Dark",
        "fontSize": 12,
        "fontFamily": "monospace"
      },
      {
        "name": "Fish",
        "commandline": "/usr/bin/fish",
        "colorScheme": "Dracula",
        "fontSize": 12,
        "fontFamily": "monospace"
      }
    ]
  },
