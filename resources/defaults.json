{
  "profiles": {
    "defaults": {
      "name": "Default",
      "commandline": "/bin/bash",
      "colorScheme": "Campbell",
      "fontSize": 12,
      "fontFamily": "monospace",
      "cursorShape": "bar",
      "cursorColor": "#FFFFFF",
      "scrollbackLines": 10000,
      "closeOnExit": "graceful"
    }
  },
  "schemes": [
    {
      "name": "Campbell",
      "foreground": "#CCCCCC",
      "background": "#0C0C0C",
      "black": "#0C0C0C",
      "red": "#C50F1F",
      "green": "#13A10E",
      "yellow": "#C19C00",
      "blue": "#0037DA",
      "purple": "#881798",
      "cyan": "#3A96DD",
      "white": "#CCCCCC",
      "brightBlack": "#767676",
      "brightRed": "#E74856",
      "brightGreen": "#16C60C",
      "brightYellow": "#F9F1A5",
      "brightBlue": "#3B78FF",
      "brightPurple": "#B4009E",
      "brightCyan": "#61D6D6",
      "brightWhite": "#F2F2F2"
    },
    {
      "name": "One Half Dark",
      "foreground": "#DCDFE4",
      "background": "#282C34",
      "black": "#282C34",
      "red": "#E06C75",
      "green": "#98C379",
      "yellow": "#E5C07B",
      "blue": "#61AFEF",
      "purple": "#C678DD",
      "cyan": "#56B6C2",
      "white": "#DCDFE4",
      "brightBlack": "#5A6374",
      "brightRed": "#E06C75",
      "brightGreen": "#98C379",
      "brightYellow": "#E5C07B",
      "brightBlue": "#61AFEF",
      "brightPurple": "#C678DD",
      "brightCyan": "#56B6C2",
      "brightWhite": "#DCDFE4"
    }
  ],
  "keybindings": [
    {
      "command": "copy",
      "keys": "ctrl+shift+c"
    },
    {
      "command": "paste",
      "keys": "ctrl+shift+v"
    },
    {
      "command": "newTab",
      "keys": "ctrl+shift+t"
    },
    {
      "command": "closeTab",
      "keys": "ctrl+shift+w"
    },
    {
      "command": "nextTab",
      "keys": "ctrl+tab"
    },
    {
      "command": "prevTab",
      "keys": "ctrl+shift+tab"
    }
  ],
  "appearance": {
    "theme": "dark",
    "opacity": 1.0,
    "useAcrylic": false,
    "showTabsInTitlebar": true,
    "alwaysShowTabs": true,
    "tabWidthMode": "equal"
  }
}
