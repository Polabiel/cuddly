  "keybindings": [
    {
      "command": "copy",
      "keys": "ctrl+shift+c"
    },
    {
      "command": "paste",
      "keys": "ctrl+shift+v"
    },
    {
      "command": "newTab",
      "keys": "ctrl+shift+t"
    },
    {
      "command": "closeTab",
      "keys": "ctrl+shift+w"
    },
    {
      "command": "nextTab",
      "keys": "ctrl+tab"
    },
    {
      "command": "prevTab",
      "keys": "ctrl+shift+tab"
    },
    {
      "command": "splitHorizontal",
      "keys": "ctrl+shift+h"
    },
    {
      "command": "splitVertical",
      "keys": "ctrl+shift+v"
    },
    {
      "command": "find",
      "keys": "ctrl+shift+f"
    }
  ],
  "appearance": {
    "theme": "dark",
    "opacity": 1.0,
    "useAcrylic": false,
    "showTabsInTitlebar": true,
    "alwaysShowTabs": true,
    "tabWidthMode": "equal"
  }
